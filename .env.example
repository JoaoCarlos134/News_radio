# =============================================================================
# Copy to .env and fill in. .env is NEVER committed (see .gitignore).
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# STAGE 3 — Script synthesis (PAID API)
# The only stage that costs money, and the only one that runs identically on
# any machine. Get a key at: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# claude-sonnet-5  -> best analysis, ~R$0.90/day (~R$27/month)  [default]
# claude-haiku-4-5 -> cheaper,       ~R$0.13/day (~R$4/month)   [see README]
SCRIPT_MODEL=claude-sonnet-5
SCRIPT_MAX_TOKENS=16000
# low | medium | high | xhigh | max
SCRIPT_EFFORT=high
# Target episode length; drives the script's word budget.
# 22 min at 172 words/min (Kokoro's measured pace) = ~3800 words.
SCRIPT_TARGET_MINUTES=22
# Hard duration ceiling. The target sits below it deliberately: the model
# misses the length in both directions, and overshooting is worse than
# undershooting.
SCRIPT_MAX_MINUTES=30

# -----------------------------------------------------------------------------
# STAGE 2 — Summarise / triage (LOCAL OLLAMA, costs R$0)
# Requires Ollama installed and the model pulled ON THE GPU MACHINE (RTX 4070).
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_TIMEOUT=180

# -----------------------------------------------------------------------------
# STAGE 4 — Audio (LOCAL KOKORO, costs R$0)
# Requires the Kokoro model files downloaded ON THE GPU MACHINE.
# Paths are relative to the repo root — do not use absolute paths here.
# -----------------------------------------------------------------------------
KOKORO_MODEL_PATH=./models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=./models/voices-v1.0.bin
# Kokoro v1.0 pt-BR voices: pf_dora (female), pm_alex, pm_santa (male).
# ef_dora is the same voice actor from the Spanish pack — same timbre, better
# trained style vector. With lang=pt-br the phonemisation stays correct, and it
# was the best of six variants in a listening test. Do not change it without
# repeating that test; the clips are in docs/voices/.
KOKORO_VOICE_MARIA=ef_dora
KOKORO_VOICE_PEDRO=pm_alex
KOKORO_SPEED=1.0
# Silence between lines, in milliseconds.
KOKORO_GAP_MS=350

# -----------------------------------------------------------------------------
# STAGE 1 — RSS collection (costs R$0, runs anywhere)
# -----------------------------------------------------------------------------
# How many hours back counts as "today's news".
FEED_WINDOW_HOURS=24
# Per-feed timeout, in seconds.
FEED_TIMEOUT=20
# Cap on items taken from any one feed (stops one outlet dominating the episode).
MAX_ITEMS_PER_FEED=25
# Days an item stays in the "already seen" cache before being forgotten.
SEEN_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# STAGE 5 — Private RSS feed publication
# -----------------------------------------------------------------------------
# Public URL where the mp3s and feed.xml are hosted (GitHub Pages / R2).
#
# PRIVACY: this feed's only protection is that its URL is hard to guess. Host it
# from a SEPARATE repository with a non-obvious name — if it is served from this
# repo's gh-pages branch, the URL is derivable by anyone who can read the README.
# This value belongs in .env only. Never commit it.
PODCAST_BASE_URL=https://YOUR-USER.github.io/your-private-feed-repo
PODCAST_TITLE=Economia e Geopolitica — Diario
PODCAST_AUTHOR=Your Name
PODCAST_EMAIL=you@example.com
PODCAST_LANGUAGE=pt-BR

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
DATA_DIR=./data
PODCAST_TZ=America/Sao_Paulo
