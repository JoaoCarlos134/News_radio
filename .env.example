# =============================================================================
# Copie para .env e preencha. O .env NUNCA vai para o Git (ver .gitignore).
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ETAPA 3 — Sintese do roteiro (API PAGA)
# Unica etapa que custa dinheiro e a unica que roda igual em qualquer maquina.
# Chave em: https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# claude-sonnet-5  -> melhor analise, ~R$0,50/dia (~R$15/mes)  [padrao]
# claude-haiku-4-5 -> mais barato,   ~R$0,16/dia (~R$5/mes)
SCRIPT_MODEL=claude-sonnet-5
SCRIPT_MAX_TOKENS=16000
# low | medium | high | xhigh | max
SCRIPT_EFFORT=high
# Alvo de duracao do episodio; guia o tamanho do roteiro.
# 22 min a 177 palavras/min (ritmo medido do Kokoro) = ~3900 palavras.
SCRIPT_TARGET_MINUTES=22
# Teto rigido de duracao. O alvo fica abaixo dele de proposito: o modelo erra o
# tamanho para os dois lados, e estourar o teto e pior que ficar curto.
SCRIPT_MAX_MINUTES=30

# -----------------------------------------------------------------------------
# ETAPA 2 — Resumo/triagem (OLLAMA LOCAL, custo R$0)
# Exige Ollama instalado e o modelo baixado NO PC DE DESTINO (RTX 4070).
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
OLLAMA_TIMEOUT=180

# -----------------------------------------------------------------------------
# ETAPA 4 — Audio (KOKORO LOCAL, custo R$0)
# Exige os arquivos do modelo Kokoro baixados NO PC DE DESTINO.
# Caminhos relativos a raiz do repo — nao use caminhos absolutos aqui.
# -----------------------------------------------------------------------------
KOKORO_MODEL_PATH=./models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=./models/voices-v1.0.bin
# Vozes PT-BR do Kokoro v1.0: pf_dora (fem), pm_alex (masc), pm_santa (masc).
# ef_dora e a mesma locutora do pack espanhol — mesmo timbre, vetor de estilo
# melhor treinado. Com lang=pt-br a fonetizacao continua correta, e foi a que
# soou melhor no teste de escuta. Nao trocar sem ouvir de novo.
KOKORO_VOICE_MARIA=ef_dora
KOKORO_VOICE_PEDRO=pm_alex
KOKORO_SPEED=1.0
# Silencio entre falas, em milissegundos.
KOKORO_GAP_MS=350

# -----------------------------------------------------------------------------
# ETAPA 1 — Coleta RSS (custo R$0, roda em qualquer lugar)
# -----------------------------------------------------------------------------
# Janela de noticias consideradas "do dia", em horas.
FEED_WINDOW_HOURS=24
# Timeout por feed, em segundos.
FEED_TIMEOUT=20
# Teto de itens aproveitados por feed (evita um veiculo dominar o episodio).
MAX_ITEMS_PER_FEED=25
# Dias que um item fica no cache de "ja visto" antes de ser esquecido.
SEEN_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# ETAPA 5 — Publicacao do feed RSS privado
# -----------------------------------------------------------------------------
# URL publica onde os mp3 e o feed.xml ficam hospedados (GitHub Pages / R2).
PODCAST_BASE_URL=https://SEU-USUARIO.github.io/1news_radio
PODCAST_TITLE=Economia e Geopolitica — Diario
PODCAST_AUTHOR=Joao
PODCAST_EMAIL=voce@exemplo.com
PODCAST_LANGUAGE=pt-BR

# -----------------------------------------------------------------------------
# Geral
# -----------------------------------------------------------------------------
DATA_DIR=./data
PODCAST_TZ=America/Sao_Paulo
